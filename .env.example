# Public site URL (sitemap / robots). Defaults to https://pareton.ai
NEXT_PUBLIC_SITE_URL=https://pareton.ai

# Pareton API base URL — server-only. Used by src/lib/api (dashboard reads).
# Never expose this to the browser (no NEXT_PUBLIC_ prefix).
PARETON_API_URL=https://api.pareton.ai

# Local UI fixtures (pass + rejected submissions). Server-only; never in prod.
# PARETON_USE_MOCKS=1

# Base URL patch artifacts are served from. Mirrors the backend's
# PARETON_S3_PUBLIC_BASE_URL. Only retrieval_url values on this host render as
# links. Unset means the default bucket.
PARETON_ARTIFACT_BASE_URL=
